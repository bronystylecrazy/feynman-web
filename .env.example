# The URL printed by `feynman serve`, including its token query parameter.
# Server-only: never prefix this value with VITE_.
FEYNMAN_URL=http://127.0.0.1:8000/?token=replace-with-your-local-token
# Optional: enable custom-provider writes for that SAME local installation.
# Use the absolute models.json path reported by `feynman doctor`.
# FEYNMAN_MODELS_PATH=/absolute/path/to/.feynman/agent/models.json
PORT=5173
