{
  "name": "feynman-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Svelte research workspace for Feynman",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@lucide/svelte": "^1.43.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked": "^18.0.12",
    "marked-katex-extension": "^5.1.12",
    "mermaid": "^11.17.2",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
